# Bank wallet keypair path (generated during blockchain setup)
# Create with: solana-keygen new --outfile ~/bank-wallet.json --no-passphrase
BANK_WALLET_PATH=/Users/jm/bank-wallet.json

# Event Token address (from Task 4: spl-token create-token)
# SAVE THIS ADDRESS - it cannot be recovered!
TOKEN_ADDRESS=YOUR_TOKEN_ADDRESS_HERE

# Server configuration
PORT=3000
NODE_ENV=development
