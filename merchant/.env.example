# Merchant wallet address (generate new wallet for merchant)
# Create with: solana-keygen new --outfile ~/merchant-wallet.json
# Get address: solana-keygen pubkey ~/merchant-wallet.json
MERCHANT_WALLET=YOUR_MERCHANT_WALLET_ADDRESS

# Event Token address (from Task 4: spl-token create-token)
# This should be the SAME token address used in backend and mobile app
TOKEN_ADDRESS=YOUR_TOKEN_ADDRESS_HERE

# Server configuration
PORT=3001
NODE_ENV=development
