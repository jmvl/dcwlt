{
  "name": "event-wallet",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf node_modules && rm -rf android/build && rm -rf android/app/build && rm -rf ios/build",
    "clean:android": "cd android && ./gradlew clean",
    "install:clean": "npm run clean && npm install",
    "prebuild": "npx expo prebuild --clean",
    "deps:check": "npx expo install --check",
    "deps:fix": "npx expo install --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@toruslabs/react-native-web-browser": "^1.0.0",
    "@web3auth/base": "^8.12.0",
    "@web3auth/react-native-sdk": "^8.1.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "ed25519-hd-key": "^1.3.0",
    "events": "^3.3.0",
    "expo": "~51.0.0",
    "expo-dev-client": "~4.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
