() => {\n    if (!walletAddress) return;\n\n    setIsRefreshing(true);\n    try {\n      const connection = new Connection(SOLANA_DEVNET_RPC);\n\n      // TODO: Update TOKEN_ADDRESS in constants.ts with actual token address\n      if (TOKEN_ADDRESS === 'YOUR_TOKEN_ADDRESS_HERE') {\n        console.warn('Token address not configured');\n        setBalance(0);\n        return;\n      }\n\n      const tokenMint = new PublicKey(TOKEN_ADDRESS);\n\n      // Get token accounts\n      const tokenAccounts = await connection.getParsedTokenAccountsByOwner(\n        new PublicKey(walletAddress),\n        { mint: tokenMint }\n      );\n\n      if (tokenAccounts.value.length > 0) {\n        const accountData = tokenAccounts.value[0].account.data.parsed;\n        const balanceAmount = accountData.info.tokenAmount.amount;\n        setBalance(parseFloat(balanceAmount) / 1e9); // Assuming 9 decimals\n      } else {\n        setBalance(0);\n      }\n    } catch (error) {\n      console.error('Error fetching balance:', error);\n    } finally {\n      setIsRefreshing(false);\n    }\n  };\n\n  const handleSimulateTopUp = async () => {\n    if (!walletAddress) {\n      Alert.alert('Error', 'Wallet not connected');\n      return;\n    }\n\n    // TODO: Call backend API /api/topup in Task 16\n    setIsLoading(true);\n    try {\n      // Simulate API call delay\n      await new Promise(resolve => setTimeout(resolve, 2000));\n\n      Alert.alert(\n        'Top-Up Simulation',\n        `In production, this would send ${TOPUP_AMOUNT} Event Tokens from the bank wallet.\\n\\nBackend integration coming in Task 16.`,\n        [{ text: 'OK' }]\n      );\n\n      // For now, just refresh balance\n      await fetchBalance();\n    } catch (error) {\n      console.error('Top-up error:', error);\n      Alert.alert('Error', 'Top-up failed');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleLogout = async () => {\n    await logout();\n  };\n\n  const truncatedAddress = walletAddress\n    ? `${walletAddress.slice(0, 4)}...${walletAddress.slice(-4)}`\n    : 'Loading...';\n\n  return (\n    <View style={styles.container}>\n      {/* Header */}\n      <View style={styles.header}>\n        <View>\n          <Text style={styles.headerTitle}>My Wallet</Text>\n          <Text style={styles.headerSubtitle}>Solana Devnet</Text>\n        </View>\n        <TouchableOpacity onPress={handleLogout}>\n          <Text style={styles.logoutButton}>Logout</Text>\n        </TouchableOpacity>\n      </View>\n\n      {/* Balance Card */}\n      <View style={styles.balanceCard}>\n        <Text style={styles.balanceLabel}>Event Tokens Balance</Text>\n        {isRefreshing ? (\n          <ActivityIndicator size=\"large\" color=\"#9945FF\" />\n        ) : (\n          <Text style={styles.balanceAmount}>{formatTokenAmount(balance)} EVT</Text>\n        )}\n        <TouchableOpacity onPress={fetchBalance} style={styles.refreshButton}>\n          <Text style={styles.refreshButtonText}>Refresh</Text>\n        </TouchableOpacity>\n      </View>\n\n      {/* Address Card */}\n      <View style={styles.addressCard}>\n        <Text style={styles.addressLabel}>Wallet Address</Text>\n        <Text style={styles.addressText} numberOfLines={1}>\n          {walletAddress || 'Loading...'}\n        </Text>\n        {walletAddress && (\n          <Text style={styles.truncatedAddress}>{truncatedAddress}</Text>\n        )}\n      </View>\n\n      {/* Action Buttons */}\n      <TouchableOpacity\n        style={styles.topUpButton}\n        onPress={handleSimulateTopUp}\n        disabled={isLoading}\n      >\n        <Text style={styles.topUpButtonText}>Simulate Top Up</Text>\n        <Text style={styles.topUpButtonSubtext}>Get {TOPUP_AMOUNT} Event Tokens</Text>\n        {isLoading && <ActivityIndicator color=\"#000\" style={{ marginTop: 8 }} />}\n      </TouchableOpacity>\n\n      <TouchableOpacity\n        style={styles.scanButton}\n        onPress={() => {\n          Alert.alert('Coming Soon', 'QR Scanner will be implemented in Task 14');\n        }}\n      >\n        <Text style={styles.scanButtonText}>Scan to Pay</Text>\n        <Text style={styles.scanButtonSubtext}>QR code payment</Text>\n      </TouchableOpacity>\n\n      {/* Devnet Notice */}\n      <View style={styles.noticeCard}>\n        <Text style={styles.noticeText}>\n          ⚠️ Devnet Only - No Real Money\n        </Text>\n        <Text style={styles.noticeSubtext}>\n          This is a proof of concept using testnet tokens.\n        </Text>\n      </View>\n    </View>\n  );\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#f5f5f5',\n    padding: 20,\n  },\n  header: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    marginBottom: 20,\n  },\n  headerTitle: {\n    fontSize: 24,\n    fontWeight: 'bold',\n    color: '#333',\n  },\n  headerSubtitle: {\n    fontSize: 12,\n    color: '#999',\n  },\n  logoutButton: {\n    color: '#9945FF',\n    fontSize: 14,\n    fontWeight: '600',\n  },\n  balanceCard: {\n    backgroundColor: '#9945FF',\n    borderRadius: 15,\n    padding: 25,\n    marginBottom: 15,\n    alignItems: 'center',\n  },\n  balanceLabel: {\n    color: '#fff',\n    fontSize: 14,\n    marginBottom: 10,\n  },\n  balanceAmount: {\n    color: '#fff',\n    fontSize: 36,\n    fontWeight: 'bold',\n  },\n  refreshButton: {\n    marginTop: 10,\n    paddingHorizontal: 16,\n    paddingVertical: 8,\n    backgroundColor: 'rgba(255,255,255,0.2)',\n    borderRadius: 20,\n  },\n  refreshButtonText: {\n    color: '#fff',\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  addressCard: {\n    backgroundColor: '#fff',\n    borderRadius: 15,\n    padding: 15,\n    marginBottom: 20,\n  },\n  addressLabel: {\n    fontSize: 12,\n    color: '#666',\n    marginBottom: 5,\n  },\n  addressText: {\n    fontSize: 14,\n    color: '#333',\n    fontFamily: 'monospace',\n  },\n  truncatedAddress: {\n    fontSize: 12,\n 